# ---------------------------------------------------------------------------
# TaskFlow HR — environment
#
# Copy to `.env` for local development. On Railway set these as service
# variables; never commit a filled-in .env. Every variable here is validated at
# boot by src/lib/env.ts — the app refuses to start if one is missing or malformed.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string. On Railway, reference the database service
# rather than pasting credentials:  DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow_hr?schema=public"

# Absolute public origin, used for links in notifications and for CSRF origin
# checks. No trailing slash.  On Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# development | production | test
NODE_ENV="development"

# Signing key for session cookies. Generate with: openssl rand -base64 32
# Server-only: never prefix with NEXT_PUBLIC_.
AUTH_SECRET="replace-me-with-a-32-byte-random-string-000000"

# --- Optional ---------------------------------------------------------------

# Base URL of the object store used for avatars and task attachments. When
# unset, uploads are disabled and the UI hides the attachment control.
# STORAGE_URL=""

# Set to "true" to expose the demo role switcher, which lets you view the app
# as any seeded user WITHOUT a password. It is refused outright when
# NODE_ENV=production — see src/server/auth/README.md.
DEV_AUTH_ENABLED="true"

# Email of the seeded user the dev auth adapter signs in by default.
DEV_AUTH_DEFAULT_USER="aarav.mehta@acmetech.example"

# Public branding. Changing these renames the product everywhere; no code edits.
NEXT_PUBLIC_APP_NAME="TaskFlow HR"
NEXT_PUBLIC_APP_TAGLINE="One workspace for your people, tasks and attendance."
