# ===========================================================================
# TaskFlow HR — environment
#
# Copy to `.env` for local development. On Railway set these as service
# variables. Never commit a filled-in .env.
#
# Every variable is validated at boot by src/lib/env.ts, which keeps two
# separate schemas so the boundary is structural rather than a convention:
#
#   serverEnv()  — SERVER ONLY. Throws if read in the browser.
#   clientEnv    — NEXT_PUBLIC_* only. Inlined into the client bundle.
#
# The app refuses to start if a required variable is missing or malformed.
# ===========================================================================


# ---------------------------------------------------------------------------
# SERVER-ONLY — secrets. Never prefix these with NEXT_PUBLIC_.
# They are never sent to the browser, never returned by an API, never logged.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# On Railway, REFERENCE the database service rather than pasting credentials:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Local development: `npm run dev:db` starts PostgreSQL 18 on :5433.
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/postgres?schema=public"

# Signing/entropy secret. Minimum 32 characters — the app refuses shorter.
#   openssl rand -base64 32
# Rotating this does NOT invalidate sessions (they are random tokens stored
# server-side), but treat it as a secret regardless.
AUTH_SECRET="replace-me-with-a-32-byte-random-string-0000"

# development | production | test
NODE_ENV="development"

# Object storage for avatars and task attachments.
# When unset, uploads are disabled and the UI hides the attachment control.
# No fake local uploader is provided — see src/server/providers/storage.ts.
# STORAGE_URL=""


# ---------------------------------------------------------------------------
# DEVELOPMENT ONLY — must be unset in production.
#
# DEV_AUTH_ENABLED turns on impersonation: any seeded user can be assumed with
# no password. It is fenced three times (NODE_ENV check in the adapter
# resolver, again inside the adapter, and again in every /api/dev route), so a
# production deploy that forgets to remove it still gets real authentication
# and a 404 on the dev routes. Do not rely on that — just leave it unset.
# ---------------------------------------------------------------------------

DEV_AUTH_ENABLED="true"
DEV_AUTH_DEFAULT_USER="aarav.mehta@acmetech.example"

# Throwaway database for integration tests. TRUNCATED on every run — never
# point this at anything you care about.
TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5433/taskflow_test?schema=public"


# ---------------------------------------------------------------------------
# BROWSER-SAFE — these are inlined into the client bundle at build time.
# Anything here is public. Never put a secret in a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------

# Absolute public origin. Used for notification links and for the CSRF origin
# check on every mutation. No trailing slash.
# On Railway:  https://${{RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Product branding. Changing these renames the product everywhere — no code
# edits required.
NEXT_PUBLIC_APP_NAME="TaskFlow HR"
NEXT_PUBLIC_APP_TAGLINE="One workspace for your people, tasks and attendance."


# ---------------------------------------------------------------------------
# BUILD
# ---------------------------------------------------------------------------

# Emit a self-contained server bundle for a slim container image.
# Opt-in because its build-trace step fails on OneDrive-synced Windows folders,
# and Railway's default Nixpacks builder does not need it.
# BUILD_STANDALONE="true"
